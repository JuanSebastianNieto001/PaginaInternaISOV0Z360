# -----------------------------------------------------------------------------
# ISO DMS · Variables de entorno
# Copia este archivo a `.env.local` y completa los valores desde
# Supabase → Project Settings → API.
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima (pública). La seguridad real la aplica Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL pública de la aplicación (usada en los enlaces de recuperación de contraseña).
# En Vercel se usa VERCEL_URL automáticamente si no se define.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SOLO SERVIDOR · NUNCA exponer en el navegador ni commitear.
# Necesaria únicamente para:
#   - Crear usuarios desde /admin/users (Supabase Auth Admin API)
#   - Scripts de bootstrap: `npm run seed:admin` y `npm run seed:demo`
# Si no se define, la app funciona igualmente pero la creación de usuarios
# desde la interfaz quedará deshabilitada con un aviso.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
